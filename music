-- 原生UI音乐播放器（无需外部库）
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 创建界面
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MusicPlayer"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- 主框架
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 300, 0, 400)
mainFrame.Position = UDim2.new(0.5, -150, 0.5, -200)
mainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

-- 标题
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Position = UDim2.new(0, 0, 0, 5)
title.BackgroundTransparency = 1
title.Text = "音乐播放器"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = mainFrame

-- 音乐ID显示
local idLabel = Instance.new("TextLabel")
idLabel.Size = UDim2.new(1, -20, 0, 25)
idLabel.Position = UDim2.new(0, 10, 0, 40)
idLabel.BackgroundTransparency = 1
idLabel.Text = "当前ID: 1845918434"
idLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
idLabel.TextScaled = true
idLabel.Font = Enum.Font.Code
idLabel.Parent = mainFrame

-- 按钮创建函数
local function CreateButton(text, position, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, position)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.Font = Enum.Font.Gotham
    btn.TextScaled = true
    btn.Parent = mainFrame
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- 音乐变量
local sound = Instance.new("Sound")
sound.Parent = SoundService
sound.Looped = true

local currentId = "rbxassetid://1845918434"
local volume = 50

-- 更新ID显示
local function UpdateIdLabel()
    local pureId = string.gsub(currentId, "rbxassetid://", "")
    idLabel.Text = "当前ID: " .. pureId
end

-- 播放函数
local function Play()
    sound.SoundId = currentId
    sound.Volume = volume / 100
    sound:Play()
    UpdateIdLabel()
end

-- 预置列表
local musicList = {
    "1845918434",
    "1843463175",
    "1837844742",
    "1843497734",
    "1840172845",
    "1334940365",
    "77715601943266",
    "16831108393",
    "107797507930019"
}

-- 按钮布局
local yPos = 75

-- 播放按钮
CreateButton("播放", yPos, function()
    Play()
end)
yPos = yPos + 40

-- 停止按钮
CreateButton("停止", yPos, function()
    sound:Stop()
end)
yPos = yPos + 40

-- 暂停/继续按钮
local pauseButton = CreateButton("暂停", yPos, function()
    if sound.IsPlaying then
        sound:Pause()
        pauseButton.Text = "继续"
    else
        sound:Resume()
        pauseButton.Text = "暂停"
    end
end)
yPos = yPos + 40

-- 音量增加
CreateButton("音量 +10", yPos, function()
    volume = math.min(100, volume + 10)
    sound.Volume = volume / 100
end)
yPos = yPos + 40

-- 音量减少
CreateButton("音量 -10", yPos, function()
    volume = math.max(0, volume - 10)
    sound.Volume = volume / 100
end)
yPos = yPos + 40

-- 随机播放
CreateButton("随机播放", yPos, function()
    currentId = "rbxassetid://" .. musicList[math.random(1, #musicList)]
    Play()
end)
yPos = yPos + 40

-- 手动输入ID（点击后弹出输入框）
CreateButton("手动输入ID", yPos, function()
    -- 使用简单的提示框（使用原生UI的TextBox）
    local inputFrame = Instance.new("Frame")
    inputFrame.Size = UDim2.new(0, 250, 0, 150)
    inputFrame.Position = UDim2.new(0.5, -125, 0.5, -75)
    inputFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    inputFrame.BorderSizePixel = 0
    inputFrame.Parent = screenGui

    local inputLabel = Instance.new("TextLabel")
    inputLabel.Size = UDim2.new(1, 0, 0, 30)
    inputLabel.Position = UDim2.new(0, 0, 0, 10)
    inputLabel.BackgroundTransparency = 1
    inputLabel.Text = "输入音频ID（数字）"
    inputLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    inputLabel.TextScaled = true
    inputLabel.Parent = inputFrame

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(1, -20, 0, 40)
    textBox.Position = UDim2.new(0, 10, 0, 50)
    textBox.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.Text = ""
    textBox.PlaceholderText = "例如: 1845918434"
    textBox.Parent = inputFrame
    textBox:CaptureFocus()

    local confirmBtn = Instance.new("TextButton")
    confirmBtn.Size = UDim2.new(0, 100, 0, 30)
    confirmBtn.Position = UDim2.new(0.5, -50, 0, 100)
    confirmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    confirmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    confirmBtn.Text = "确定"
    confirmBtn.Parent = inputFrame
    confirmBtn.MouseButton1Click:Connect(function()
        local id = textBox.Text
        if id ~= "" and tonumber(id) then
            currentId = "rbxassetid://" .. id
            Play()
            inputFrame:Destroy()
        end
    end)

    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Size = UDim2.new(0, 100, 0, 30)
    cancelBtn.Position = UDim2.new(0.5, -50, 0, 135)
    cancelBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    cancelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    cancelBtn.Text = "取消"
    cancelBtn.Parent = inputFrame
    cancelBtn.MouseButton1Click:Connect(function()
        inputFrame:Destroy()
    end)
end)
yPos = yPos + 40

-- 显示当前ID
CreateButton("复制当前ID", yPos, function()
    local pureId = string.gsub(currentId, "rbxassetid://", "")
    pcall(function()
        GuiService:SetClipboard(pureId)
    end)
end)
yPos = yPos + 40

-- 初始化显示
UpdateIdLabel()
sound.Volume = volume / 100