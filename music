-- 当前播放列表索引（用于列表循环）
local CurrentPlaylistIndex = 1
local EndedConnection = nil -- 保存Ended事件连接，防止重复

-- ========== 核心播放函数 ==========
local function PlaySoundById(id, loopSingle)
    local soundId = "rbxassetid://" .. id
    if not MusicSound then
        MusicSound = Instance.new("Sound")
        MusicSound.Name = "PlayerMusic"
        MusicSound.Parent = game:GetService("SoundService")
    end
    MusicSound.SoundId = soundId
    MusicSound.Volume = IsMuted and 0 or (CurrentVolume / 100)
    MusicSound.Looped = loopSingle
    pcall(function()
        MusicSound:Play()
    end)
    CurrentSoundId = soundId
end

-- 清理旧Ended连接
local function ClearEndedConnection()
    if EndedConnection then
        pcall(function() EndedConnection:Disconnect() end)
        EndedConnection = nil
    end
end

-- 处理播放列表自动切换
local function SetupPlaylistAutoNext()
    ClearEndedConnection()
    if LoopMode == "single" or #CustomPlaylist == 0 then
        return
    end
    -- 如果只有一首且循环模式不是single，直接设置Looped=true，不依赖Ended事件
    if #CustomPlaylist == 1 then
        MusicSound.Looped = true
        return
    end
    MusicSound.Looped = false
    EndedConnection = MusicSound.Ended:Connect(function()
        if LoopMode == "list" then
            CurrentPlaylistIndex = (CurrentPlaylistIndex % #CustomPlaylist) + 1
        elseif LoopMode == "random" then
            CurrentPlaylistIndex = math.random(1, #CustomPlaylist)
        elseif LoopMode == "order" then
            if CurrentPlaylistIndex >= #CustomPlaylist then
                MusicSound:Stop()
                ClearEndedConnection()
                return
            else
                CurrentPlaylistIndex = CurrentPlaylistIndex + 1
            end
        end
        MusicSound.SoundId = "rbxassetid://" .. CustomPlaylist[CurrentPlaylistIndex]
        pcall(function() MusicSound:Play() end)
    end)
end

