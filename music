-- 加载你提供的UI库
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/dhvkgbhic/1578/refs/heads/main/ui"))()

local Window = OrionLib:MakeWindow({
    Name = "音乐播放器",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "MusicIDPlayer"
})

local Tab = Window:MakeTab({
    Name = "音乐控制",
    Icon = "rbxassetid://18270615016",
    PremiumOnly = false
})

-- 核心变量
local MusicSound = nil
local CurrentSoundId = "rbxassetid://0" 
local CurrentVolume = 50 -- 默认音量设为50（对应0.5）

-- 预置的音乐ID列表
local MusicList = {
    "1845918434", 
    "1843463175",
    "1837844742",
    "1843497734",
    "1840172845",
    "1334940365"
}

-- 音乐ID选择下拉菜单
Tab:AddDropdown({
    Name = "选择音乐ID",
    Default = "1845918434",
    Options = MusicList,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
        OrionLib:MakeNotification({
            Name = "已选择",
            Content = "当前选中ID: " .. Value,
            Time = 3
        })
    end
})

-- 复制选中的ID
Tab:AddButton({
    Name = "复制选中的音乐ID",
    Callback = function()
        local PureID = string.gsub(CurrentSoundId, "rbxassetid://", "")
        pcall(function()
            game:GetService("GuiService"):SetClipboard(PureID)
        end)
        OrionLib:MakeNotification({
            Name = "复制成功",
            Content = "ID已复制: " .. PureID,
            Time = 3
        })
    end
})

local Section = Tab:AddSection({
        Name = "好听↓"
})


Tab:AddButton({

        Name = "复制一个好听的",

        Callback = function()

     setclipboard("77715601943266")

          end

})

local Section = Tab:AddSection({
        Name = "好听↑"
})


-- 手动输入音频ID
Tab:AddTextbox({
    Name = "手动输入音频ID",
    Default = "例如:1000＿",
    TextDisappear = true,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
    end
})

-- ==========================================
-- 【新版】音量控制设置（替换了原来的滑条）
-- 输入范围：0 - 100
-- ==========================================
Tab:AddTextbox({
    Name = "音量控制设置 (0-100)",
    Default = "50",
    TextDisappear = true,
    Callback = function(Value)
        -- 把文本转换成数字，防止输入文字报错
        local vol = tonumber(Value)
        if not vol then 
            vol = 50 -- 如果输入的不是数字，就恢复默认
        end
        
        -- 限制音量范围在 0 到 100 之间
        if vol > 100 then vol = 100 end
        if vol < 0 then vol = 0 end
        
        CurrentVolume = vol
        
        -- 实时应用音量（除以100转换为Roblox的0-1）
        if MusicSound then
            pcall(function()
                MusicSound.Volume = CurrentVolume / 100
            end)
        end
    end
})
-- ==========================================

-- 开始播放
Tab:AddButton({
    Name = "开始播放音乐",
    Callback = function()
        if CurrentSoundId == "rbxassetid://0" then
            OrionLib:MakeNotification({
                Name = "错误",
                Content = "请先输入或选择有效的音频ID！",
                Time = 3
            })
            return
        end
        
        if not MusicSound then
            MusicSound = Instance.new("Sound")
            MusicSound.Name = "PlayerMusic"
            MusicSound.Parent = game:GetService("SoundService")
            MusicSound.Looped = true
            MusicSound.Volume = CurrentVolume / 100
        end
        
        MusicSound.SoundId = CurrentSoundId
        pcall(function()
            MusicSound:Play()
        end)
    end
})

-- 重新播放
Tab:AddButton({
    Name = "重新播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Stop()
            MusicSound:Play()
        end
    end
})

-- 停止播放
Tab:AddButton({
    Name = "停止播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Stop()
        end
    end
})

-- 继续播放
Tab:AddButton({
    Name = "继续播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Resume()
        end
    end
})

