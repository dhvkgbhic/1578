-- 加载你提供的UI库
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/dhvkgbhic/1578/refs/heads/main/ui"))()

local Window = OrionLib:MakeWindow({
    Name = "音乐播放器",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "MusicIDPlayer"
})

local Tab = Window:MakeTab({
    Name = "音乐",
    Icon = "rbxassetid://18270615016",
    PremiumOnly = false
})

-- 核心变量
local MusicSound = nil
local CurrentSoundId = "rbxassetid://0" 
local CurrentVolume = 5

-- 预置的音乐ID列表（你可以随意修改里面的数字）
local MusicList = {
    "1845918434", 
    "1843463175",
    "1837844742",
    "1843497734",
    "1840172845",
    "1334940365"
}

-- 新增：音乐ID选择下拉菜单
Tab:AddDropdown({
    Name = "选择音乐ID",
    Default = "1845918434",
    Options = MusicList,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
        OrionLib:MakeNotification({
            Name = "已选择",
            Content = "当前选中ID: " .. Value,
            Time = 3
        })
    end
})

-- 新增：一键复制选中的ID（方便你分享给别人）
Tab:AddButton({
    Name = "复制选中的音乐ID",
    Callback = function()
        -- 提取纯数字ID用于复制
        local PureID = string.gsub(CurrentSoundId, "rbxassetid://", "")
        
        -- 调用Roblox内置剪贴板 API
        pcall(function()
            game:GetService("GuiService"):SetClipboard(PureID)
        end)

        OrionLib:MakeNotification({
            Name = "复制成功",
            Content = "ID已复制: " .. PureID,
            Time = 3
        })
    end
})

Tab:AddButton({

        Name = "复制一个超好听的",

        Callback = function()

     setclipboard("77715601943266")

          end

})


-- 原有的：输入音频ID (保留手动输入功能)
Tab:AddTextbox({
    Name = "手动输入音频ID",
    Default = "例如: 1845918434",
    TextDisappear = true,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
    end
})

-- 原有的：音量控制滑条
Tab:AddSlider({
    Name = "音量控制 (0-10)",
    MinValue = 0,
    MaxValue = 10,
    Default = CurrentVolume,
    Color = Color3.fromRGB(255, 0, 0),
    Increment = 1,
    Callback = function(Value)
        local numValue = tonumber(Value) or CurrentVolume
        CurrentVolume = numValue
        if MusicSound then
            pcall(function()
                MusicSound.Volume = numValue / 10
            end)
        end
    end
})

-- 原有的：开始播放
Tab:AddButton({
    Name = "开始播放音乐",
    Callback = function()
        if CurrentSoundId == "rbxassetid://0" then
            OrionLib:MakeNotification({
                Name = "错误",
                Content = "请先输入或选择有效的音频ID！",
                Time = 3
            })
            return
        end
        
        if not MusicSound then
            MusicSound = Instance.new("Sound")
            MusicSound.Name = "PlayerMusic"
            MusicSound.Parent = game:GetService("SoundService")
            MusicSound.Looped = true
            MusicSound.Volume = tonumber(CurrentVolume) / 10
        end
        
        MusicSound.SoundId = CurrentSoundId
        pcall(function()
            MusicSound:Play()
        end)
    end
})

-- 原有的：重新播放
Tab:AddButton({
    Name = "重新播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Stop()
            MusicSound:Play()
        end
    end
})

-- 原有的：停止播放
Tab:AddButton({
    Name = "停止播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Stop()
        end
    end
})

-- 原有的：继续播放
Tab:AddButton({
    Name = "继续播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Resume()
        end
    end
})

-- 初始化UI
OrionLib:Init()