-- 播放自定义播放列表
Tab:AddButton({
    Name = "播放自定义列表",
    Callback = function()
        if #CustomPlaylist == 0 then
            OrionLib:MakeNotification({
                Name = "错误",
                Content = "播放列表为空，请先添加音频ID",
                Time = 3
            })
            return
        end
        CurrentSoundId = "rbxassetid://" .. CustomPlaylist[1]
        if not MusicSound then
            MusicSound = Instance.new("Sound")
            MusicSound.Name = "PlayerMusic"
            MusicSound.Parent = game:GetService("SoundService")
            MusicSound.Volume = IsMuted and 0 or (CurrentVolume / 100)
        else
            MusicSound.Volume = IsMuted and 0 or (CurrentVolume / 100)
        end
        MusicSound.SoundId = CurrentSoundId
        MusicSound.Looped = (LoopMode == "single" and #CustomPlaylist == 1)
        pcall(function() MusicSound:Play() end)

        if LoopMode ~= "single" then
            if MusicSound.Ended then
                MusicSound.Ended:Disconnect()
            end
            local currentIndex = 1
            MusicSound.Ended:Connect(function()
                if LoopMode == "list" then
                    currentIndex = (currentIndex % #CustomPlaylist) + 1
                elseif LoopMode == "random" then
                    currentIndex = math.random(1, #CustomPlaylist)
                elseif LoopMode == "order" then
                    if currentIndex >= #CustomPlaylist then
                        MusicSound:Stop()
                        return
                    else
                        currentIndex = currentIndex + 1
                    end
                end
                MusicSound.SoundId = "rbxassetid://" .. CustomPlaylist[currentIndex]
                MusicSound:Play()
            end)
        end
        OrionLib:MakeNotification({
            Name = "播放列表",
            Content = "开始播放自定义列表，共 " .. #CustomPlaylist .. " 首",
            Time = 3
        })
    end
})

