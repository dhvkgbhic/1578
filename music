-- 加载你提供的UI库
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/dhvkgbhic/1578/refs/heads/main/ui"))()
local Window = OrionLib:MakeWindow({
    Name = "音乐播放器",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "MusicIDPlayer"
})
local Tab = Window:MakeTab({
    Name = "音乐控制",
    Icon = "rbxassetid://18270615016",
    PremiumOnly = false
})

-- 核心变量
local MusicSound = nil
local CurrentSoundId = "rbxassetid://0" 
local CurrentVolume = 50
local LoopEnabled = true
local LastVolume = CurrentVolume
local PlaySpeed = 1
local AutoRandomEnabled = false
local AutoRandomDelay = 30
local AutoRandomTask = nil
local CurrentPlaylistIndex = 1
local AutoNextOnEnd = false
local FadeTime = 0.5
local SleepTask = nil
local SleepDuration = 60
local LyricsEnabled = false
local LyricsTable = {}
local LyricsIsTimestamped = false
local LyricsInterval = 5
local LyricsTask = nil
local CurrentLyricIndex = 0

-- 歌词显示界面
local LyricsGui = Instance.new("ScreenGui")
LyricsGui.Name = "LyricsGui"
LyricsGui.ResetOnSpawn = false
LyricsGui.Parent = game:GetService("CoreGui")
LyricsGui.IgnoreGuiInset = true
local LyricsLabel = Instance.new("TextLabel")
LyricsLabel.Parent = LyricsGui
LyricsLabel.AnchorPoint = Vector2.new(0.5, 1)
LyricsLabel.Position = UDim2.new(0.5, 0, 0.9, 0)
LyricsLabel.Size = UDim2.new(0.8, 0, 0.2, 0)
LyricsLabel.BackgroundTransparency = 0.8
LyricsLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
LyricsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
LyricsLabel.TextStrokeTransparency = 0.5
LyricsLabel.TextSize = 24
LyricsLabel.Font = Enum.Font.GothamBold
LyricsLabel.Text = "等待歌词中..."
LyricsLabel.TextWrapped = true
LyricsLabel.Visible = false

-- 预置的音乐ID列表
local MusicList = {
    "1845918434", 
    "1843463175",
    "1837844742",
    "1843497734",
    "1840172845",
    "1334940365"
}

local Dropdown = Tab:AddDropdown({
    Name = "选择音乐ID",
    Default = "1845918434",
    Options = MusicList,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
        for i,v in ipairs(MusicList) do
            if v == Value then CurrentPlaylistIndex = i end
        end
        OrionLib:MakeNotification({Name="已选择",Content="当前选中ID: "..Value,Time=3})
    end
})

-- 手动输入音频ID（下拉菜单卡死时的备用方案）
Tab:AddTextbox({
    Name = "手动输入音频ID",
    Default = "例如: 1845918434",
    TextDisappear = true,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
    end
})

-- 复制选中的ID
Tab:AddButton({
    Name = "复制选中的音乐ID",
    Callback = function()
        local PureID = string.gsub(CurrentSoundId, "rbxassetid://", "")
        pcall(function() game:GetService("GuiService"):SetClipboard(PureID) end)
        OrionLib:MakeNotification({Name="复制成功",Content="ID已复制: "..PureID,Time=3})
    end
})

-- 音量控制
Tab:AddTextbox({
    Name = "音量控制设置 (0-100)",
    Default = "50",
    TextDisappear = true,
    Callback = function(Value)
        local vol = tonumber(Value) or 50
        if vol > 100 then vol = 100 end
        if vol < 0 then vol = 0 end
        CurrentVolume = vol
        if MusicSound then pcall(function() MusicSound.Volume = CurrentVolume / 100 end) end
    end
})
Tab:AddButton({ Name = "🔊音量+5", Callback = function()
    CurrentVolume = math.min(100, CurrentVolume + 5)
    if MusicSound then pcall(function() MusicSound.Volume = CurrentVolume / 100 end) end
    OrionLib:MakeNotification({Name="音量+",Content="当前音量: "..CurrentVolume,Time=1})
end})
Tab:AddButton({ Name = "🔉音量-5", Callback = function()
    CurrentVolume = math.max(0, CurrentVolume - 5)
    if MusicSound then pcall(function() MusicSound.Volume = CurrentVolume / 100 end) end
    OrionLib:MakeNotification({Name="音量-",Content="当前音量: "..CurrentVolume,Time=1})
end})

-- 基础控制
Tab:AddToggle({ Name = "循环播放", Default = true, Callback = function(State)
    LoopEnabled = State
    if MusicSound then pcall(function() MusicSound.Looped = LoopEnabled end) end
end})
Tab:AddButton({ Name = "🎲随机播放预置音乐", Callback = function()
    local RandIndex = math.random(1,#MusicList)
    local SelectID = MusicList[RandIndex]
    CurrentPlaylistIndex = RandIndex
    CurrentSoundId = "rbxassetid://"..SelectID
    if MusicSound then MusicSound.SoundId = CurrentSoundId; pcall(function() MusicSound:Play() end) end
end})
Tab:AddButton({ Name = "🔇静音 / 恢复音量", Callback = function()
    if not MusicSound then return end
    if CurrentVolume ~= 0 then LastVolume = CurrentVolume; CurrentVolume = 0
    else CurrentVolume = LastVolume end
    pcall(function() MusicSound.Volume = CurrentVolume / 100 end)
end})
Tab:AddTextbox({ Name = "⏱跳转播放位置(秒)", Default = "0", TextDisappear = true, Callback = function(Val)
    local JumpSec = tonumber(Val)
    if not JumpSec or not MusicSound then return end
    pcall(function() MusicSound.TimePosition = JumpSec end)
end})

-- 彻底销毁音频
Tab:AddButton({ Name = "🗑彻底销毁音频对象", Callback = function()
    if AutoRandomTask then task.cancel(AutoRandomTask) AutoRandomTask = nil end
    if SleepTask then task.cancel(SleepTask) SleepTask = nil end
    if LyricsTask then task.cancel(LyricsTask) LyricsTask = nil end
    AutoRandomEnabled = false
    if MusicSound then pcall(function() MusicSound:Stop(); MusicSound:Destroy() end); MusicSound = nil end
    LyricsLabel.Visible = false
end})
Tab:AddButton({ Name = "ℹ查看当前播放信息", Callback = function()
    if not MusicSound then return end
    local PureId = string.gsub(CurrentSoundId,"rbxassetid://","")
    OrionLib:MakeNotification({Name="播放信息",Content=string.format("ID:%s |音量:%d |循环:%s |速度:%.1f",PureId,CurrentVolume,tostring(LoopEnabled),PlaySpeed),Time=4})
end})

-- 播放速度与切歌
Tab:AddTextbox({ Name = "⏩播放速度(0.5‑2)", Default = "1", TextDisappear = true, Callback = function(val)
    local speed = tonumber(val) or 1
    if speed <0.5 then speed=0.5 end
    if speed>2 then speed=2 end
    PlaySpeed = speed
    if MusicSound then pcall(function() MusicSound.PlaybackSpeed = PlaySpeed end) end
end})
Tab:AddButton({ Name = "⏮上一首", Callback = function()
    CurrentPlaylistIndex -=1
    if CurrentPlaylistIndex <1 then CurrentPlaylistIndex = #MusicList end
    local selId = MusicList[CurrentPlaylistIndex]
    CurrentSoundId = "rbxassetid://"..selId
    if MusicSound then MusicSound.SoundId = CurrentSoundId; pcall(function() MusicSound:Play() end) end
end})
Tab:AddButton({ Name = "⏭下一首", Callback = function()
    CurrentPlaylistIndex +=1
    if CurrentPlaylistIndex > #MusicList then CurrentPlaylistIndex =1 end
    local selId = MusicList[CurrentPlaylistIndex]
    CurrentSoundId = "rbxassetid://"..selId
    if MusicSound then MusicSound.SoundId = CurrentSoundId; pcall(function() MusicSound:Play() end) end
end})

-- =====【核心修复：歌单管理（延迟刷新，彻底清除空行）】=====
Tab:AddTextbox({ Name = "➕添加ID到歌单", Default = "输入数字ID", TextDisappear = true, Callback = function(val)
    local id = string.gsub(val, "%D", "")
    if id == "" or #id < 3 then return end
    table.insert(MusicList, id)
    task.spawn(function() task.wait(0.1) pcall(function() Dropdown:Refresh() end) end)
end})

Tab:AddTextbox({ Name = "❌删除歌单里指定ID", Default = "输入要删除的ID", TextDisappear = true, Callback = function(val)
    local id = string.gsub(val, "%D", "")
    if id == "" then return end
    for i, v in ipairs(MusicList) do
        if v == id then
            table.remove(MusicList, i)
            task.spawn(function() task.wait(0.1) pcall(function() Dropdown:Refresh() end) end)
            return
        end
    end
end})

Tab:AddButton({ Name = "🧹清空自定义歌单", Callback = function()
    MusicList = {"1845918434", "1843463175", "1837844742", "1843497734", "1840172845", "1334940365"}
    CurrentPlaylistIndex = 1
    task.spawn(function() task.wait(0.1) pcall(function() Dropdown:Refresh() end) end)
end})

-- =====【核心修复：导入歌单（剔除空行/无效字符）】=====
Tab:AddTextbox({ Name = "📥导入歌单(换行分隔ID)", Default = "粘贴多行ID", TextDisappear = true, Callback = function(text)
    for id in string.gmatch(text, "[^\r\n]+") do
        id = string.gsub(id, "%D", "")
        if id ~= "" and #id > 2 then
            table.insert(MusicList, id)
        end
    end
    task.spawn(function() task.wait(0.1) pcall(function() Dropdown:Refresh() end) end)
    OrionLib:MakeNotification({Name="导入完成",Content="已批量添加ID进歌单",Time=3})
end})

-- 自动切歌
Tab:AddTextbox({ Name = "🔁自动切歌间隔(秒)", Default = "30", TextDisappear = true, Callback = function(val)
    local num = tonumber(val)
    if num and num >=5 then AutoRandomDelay = num end
end})
Tab:AddToggle({ Name = "🔁开启自动随机切歌", Default = false, Callback = function(state)
    AutoRandomEnabled = state
    if state then
        AutoRandomTask = task.spawn(function()
            while AutoRandomEnabled do
                task.wait(AutoRandomDelay)
                if not AutoRandomEnabled then break end
                local randI = math.random(1,#MusicList)
                CurrentPlaylistIndex = randI
                local sid = MusicList[randI]
                CurrentSoundId = "rbxassetid://"..sid
                if MusicSound then pcall(function() MusicSound.SoundId = CurrentSoundId; MusicSound:Play() end) end
            end
        end)
    else
        if AutoRandomTask then task.cancel(AutoRandomTask) AutoRandomTask=nil end
    end
end})

-- 歌曲结束自动下一首
Tab:AddToggle({ Name = "✨歌曲结束自动下一首", Default = false, Callback = function(state)
    AutoNextOnEnd = state
    if MusicSound and state then
        pcall(function()
            MusicSound.Ended:Connect(function()
                if AutoNextOnEnd and not LoopEnabled then
                    CurrentPlaylistIndex +=1
                    if CurrentPlaylistIndex>#MusicList then CurrentPlaylistIndex=1 end
                    local selId = MusicList[CurrentPlaylistIndex]
                    CurrentSoundId = "rbxassetid://"..selId
                    MusicSound.SoundId = CurrentSoundId
                    MusicSound:Play()
                end
            end)
        end)
    end
end})

-- 淡入淡出
Tab:AddTextbox({ Name = "🌫设置淡入淡出时间(秒)", Default = "0.5", TextDisappear = true, Callback = function(val)
    local t = tonumber(val)
    if t and t > 0 then FadeTime = t end
end})
Tab:AddButton({ Name = "🌫音量淡入淡出切换", Callback = function()
    if not MusicSound then return end
    task.spawn(function()
        local startVol = MusicSound.Volume
        local target = startVol>0 and 0 or LastVolume/100
        local steps = 20
        local delta = (target-startVol)/steps
        for i=1,steps do task.wait(FadeTime/steps); MusicSound.Volume = startVol + delta*i end
        CurrentVolume = math.floor(target*100)
    end)
end})

-- 歌词
Tab:AddTextbox({ Name = "📝导入歌词(支持[分:秒]格式)", Default = "每行一句歌词，或[00:10]歌词格式", TextDisappear = false, Callback = function(text)
    LyricsTable = {}
    LyricsIsTimestamped = false
    for line in string.gmatch(text, "[^\r\n]+") do
        table.insert(LyricsTable, line)
        if string.match(line, "%[(%d+):(%d+)%]") then LyricsIsTimestamped = true end
    end
end})
Tab:AddToggle({ Name = "🎤显示歌词", Default = false, Callback = function(state)
    LyricsEnabled = state
    LyricsLabel.Visible = LyricsEnabled
    if state and MusicSound then
        if LyricsTask then task.cancel(LyricsTask) end
        LyricsTask = task.spawn(function()
            while LyricsEnabled do
                task.wait(0.1)
                if not MusicSound or not LyricsEnabled then break end
                local currentTime = MusicSound.TimePosition
                if LyricsIsTimestamped then
                    for i, line in ipairs(LyricsTable) do
                        local mm, ss, text = string.match(line, "%[(%d+):(%d+)%](.+)")
                        if mm and ss and text then
                            local targetTime = (tonumber(mm) * 60) + tonumber(ss)
                            if currentTime >= targetTime and (i == #LyricsTable or currentTime < (tonumber(string.match(LyricsTable[i+1], "%[(%d+):(%d+)%]")) or 999999) * 1) then
                                LyricsLabel.Text = text
                            end
                        end
                    end
                else
                    local currentLine = math.floor(currentTime / LyricsInterval) + 1
                    if currentLine > #LyricsTable then LyricsLabel.Text = "---"
                    elseif currentLine ~= CurrentLyricIndex then
                        CurrentLyricIndex = currentLine
                        LyricsLabel.Text = LyricsTable[currentLine]
                    end
                end
            end
        end)
    end
end})

-- 睡眠定时
Tab:AddTextbox({ Name = "⏰设置睡眠定时(秒)", Default = "60", TextDisappear = true, Callback = function(val)
    local t = tonumber(val)
    if t and t > 0 then SleepDuration = t end
end})
Tab:AddButton({ Name = "⏰开启睡眠定时", Callback = function()
    if SleepTask then task.cancel(SleepTask); SleepTask = nil end
    SleepTask = task.spawn(function()
        task.wait(SleepDuration)
        if MusicSound then pcall(function() MusicSound:Pause() end) end
    end)
end})

-- 总控停止
Tab:AddButton({ Name = "🛑全部停止&关闭自动切歌", Callback = function()
    AutoRandomEnabled = false
    if AutoRandomTask then task.cancel(AutoRandomTask) AutoRandomTask=nil end
    if SleepTask then task.cancel(SleepTask) SleepTask=nil end
    if LyricsTask then task.cancel(LyricsTask) LyricsTask=nil end
    if MusicSound then pcall(function() MusicSound:Stop() end) end
end})

-- 基础播放控件
Tab:AddButton({ Name = "开始播放音乐", Callback = function()
    if CurrentSoundId == "rbxassetid://0" then return end
    if not MusicSound then
        MusicSound = Instance.new("Sound")
        MusicSound.Name = "PlayerMusic"
        MusicSound.Parent = game:GetService("SoundService")
        MusicSound.Looped = LoopEnabled
        MusicSound.Volume = CurrentVolume / 100
        MusicSound.PlaybackSpeed = PlaySpeed
    end
    MusicSound.SoundId = CurrentSoundId
    pcall(function() MusicSound:Play() end)
end})
Tab:AddButton({ Name = "重新播放音乐", Callback = function() if MusicSound then MusicSound:Stop(); MusicSound:Play() end end })
Tab:AddButton({ Name = "停止播放音乐", Callback = function() if MusicSound then MusicSound:Stop() end end })
Tab:AddButton({ Name = "继续播放音乐", Callback = function() if MusicSound then MusicSound:Resume() end end })

