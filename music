-- 播放/暂停切换
Tab:AddButton({
    Name = "播放/暂停切换",
    Callback = function()
        if not MusicSound then
            -- 如果还没有声音对象，则直接开始播放
            if CurrentSoundId == "rbxassetid://0" then
                OrionLib:MakeNotification({
                    Name = "错误",
                    Content = "请先选择或输入有效音频ID",
                    Time = 3
                })
                return
            end
            MusicSound = Instance.new("Sound")
            MusicSound.Name = "PlayerMusic"
            MusicSound.Parent = game:GetService("SoundService")
            MusicSound.Looped = (LoopMode == "single")
            MusicSound.Volume = IsMuted and 0 or (CurrentVolume / 100)
            MusicSound.SoundId = CurrentSoundId
            pcall(function() MusicSound:Play() end)
        else
            if MusicSound.IsPlaying then
                MusicSound:Pause()
            else
                -- 如果声音已停止或暂停，则继续播放；如果已结束且不是循环，可能需要重新播放
                if MusicSound.TimePosition >= MusicSound.TimeLength and MusicSound.TimeLength > 0 and not MusicSound.Looped then
                    MusicSound:Stop()
                    MusicSound:Play()
                else
                    MusicSound:Resume()
                end
            end
        end
    end
})

