Tab:AddButton({
    Name = "导入播放列表",
    Callback = function()
        local text = GetClipboard()
        if text == "" then
            OrionLib:MakeNotification({
                Name = "错误",
                Content = "剪贴板为空或无法读取",
                Time = 3
            })
            return
        end
        local ids = {}
        for id in string.gmatch(text, "[^,]+") do
            id = id:gsub("%s+", "")
            if id ~= "" then
                table.insert(ids, id)
            end
        end
        if #ids == 0 then
            OrionLib:MakeNotification({
                Name = "错误",
                Content = "剪贴板中没有有效的音频ID",
                Time = 3
            })
            return
        end
        CustomPlaylist = ids
        OrionLib:MakeNotification({
            Name = "导入成功",
            Content = "已导入 " .. #CustomPlaylist .. " 首音乐到播放列表",
            Time = 3
        })
