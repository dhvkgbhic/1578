                -- 还原原始视角参数
                pcall(function()
                    if originalMin ~= nil then
                        LocalPlayer.CameraMinZoomDistance = originalMin
                    end
                    if originalMax ~= nil then
                        LocalPlayer.CameraMaxZoomDistance = originalMax
                    end
                    originalMin = nil
                    originalMax = nil
                end)
                return
