Tab:AddToggle({
    Name = "循环拉屎。",
    Default = false,
    Callback = (function()
        local loopThread = nil
        local PacketRemote = nil
        
        return function(Value)
            -- 关闭开关：立刻终止循环线程
            if not Value then
                if loopThread then
                    task.cancel(loopThread)
                    loopThread = nil
                end
                return
            end

            -- 首次开启自动查找远程事件，只找一次
            if not PacketRemote then
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                PacketRemote = ReplicatedStorage:FindFirstChild("Packets", true)
                if PacketRemote then
                    PacketRemote = PacketRemote:FindFirstChild("Packet", true)
                    if PacketRemote then
                        PacketRemote = PacketRemote:FindFirstChild("RemoteEvent", true)
                    end
                end
                if not PacketRemote then
                    warn("路径错误：找不到 ReplicatedStorage.Packets.Packet.RemoteEvent")
                    return
                end
            end

            -- 防止重复开启多个循环
            if loopThread then return end

            -- 启动每秒循环
            loopThread = task.spawn(function()
                while true do
                    local ok, err = pcall(function()
                        PacketRemote:FireServer(buffer.fromstring("\000\000\000\000"))
                    end)
                    if not ok then
                        warn("出错：" .. err)
                    end
                    task.wait(1)
                end
            end)
        end
    end)()
})
