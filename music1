-- 加载你提供的UI库
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/dhvkgbhic/1578/refs/heads/main/ui"))()
local Window = OrionLib:MakeWindow({
    Name = "音乐播放器",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "MusicIDPlayer"
})
local Tab = Window:MakeTab({
    Name = "音乐控制",
    Icon = "rbxassetid://18270615016",
    PremiumOnly = false
})
-- 核心变量
local MusicSound = nil
local CurrentSoundId = "rbxassetid://0" 
local CurrentVolume = 50 -- 默认音量设为50（对应0.5）

--【第一波新增变量】
local LoopEnabled = true
local LastVolume = CurrentVolume

--【第二次新增变量】
local PlaySpeed = 1
local AutoRandomEnabled = false
local AutoRandomDelay = 30
local AutoRandomTask = nil
local CurrentPlaylistIndex = 1

--【本次新增变量】
local AutoNextOnEnd = false
local FadeTime = 0.5

-- 预置的音乐ID列表
local MusicList = {
    "1845918434", 
    "1843463175",
    "1837844742",
    "1843497734",
    "1840172845",
    "1334940365"
}
-- 音乐ID选择下拉菜单
Tab:AddDropdown({
    Name = "选择音乐ID",
    Default = "1845918434",
    Options = MusicList,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
        -- 更新列表索引
        for i,v in ipairs(MusicList) do
            if v == Value then CurrentPlaylistIndex = i end
        end
        OrionLib:MakeNotification({
            Name = "已选择",
            Content = "当前选中ID: " .. Value,
            Time = 3
        })
    end
})
-- 复制选中的ID
Tab:AddButton({
    Name = "复制选中的音乐ID",
    Callback = function()
        local PureID = string.gsub(CurrentSoundId, "rbxassetid://", "")
        pcall(function()
            game:GetService("GuiService"):SetClipboard(PureID)
        end)
        OrionLib:MakeNotification({
            Name = "复制成功",
            Content = "ID已复制: " .. PureID,
            Time = 3
        })
    end
})
-- 手动输入音频ID
Tab:AddTextbox({
    Name = "手动输入音频ID",
    Default = "例如: 1845918434",
    TextDisappear = true,
    Callback = function(Value)
        CurrentSoundId = "rbxassetid://" .. Value
    end
})
-- ==========================================
-- 音量控制设置
-- ==========================================
Tab:AddTextbox({
    Name = "音量控制设置 (0-100)",
    Default = "50",
    TextDisappear = true,
    Callback = function(Value)
        -- 把文本转换成数字，防止输入文字报错
        local vol = tonumber(Value)
        if not vol then 
            vol = 50 -- 如果输入的不是数字，就恢复默认
        end
        
        -- 限制音量范围在 0 到 100 之间
        if vol > 100 then vol = 100 end
        if vol < 0 then vol = 0 end
        
        CurrentVolume = vol
        
        -- 实时应用音量（除以100转换为Roblox的0-1）
        if MusicSound then
            pcall(function()
                MusicSound.Volume = CurrentVolume / 100
            end)
        end
    end
})

--====================【第一波新增功能】====================
--循环播放开关
Tab:AddToggle({
    Name = "循环播放",
    Default = true,
    Callback = function(State)
        LoopEnabled = State
        if MusicSound then
            pcall(function()
                MusicSound.Looped = LoopEnabled
            end)
        end
    end
})

--随机播放预置音乐
Tab:AddButton({
    Name = "🎲随机播放预置音乐",
    Callback = function()
        local RandIndex = math.random(1,#MusicList)
        local SelectID = MusicList[RandIndex]
        CurrentPlaylistIndex = RandIndex
        CurrentSoundId = "rbxassetid://"..SelectID
        OrionLib:MakeNotification({
            Name = "随机切歌",
            Content = "选中ID："..SelectID,
            Time = 3
        })
        if MusicSound then
            MusicSound.SoundId = CurrentSoundId
            pcall(function() MusicSound:Play() end)
        end
    end
})

--静音/恢复音量
Tab:AddButton({
    Name = "🔇静音 / 恢复音量",
    Callback = function()
        if not MusicSound then return end
        if CurrentVolume ~= 0 then
            LastVolume = CurrentVolume
            CurrentVolume = 0
        else
            CurrentVolume = LastVolume
        end
        pcall(function()
            MusicSound.Volume = CurrentVolume / 100
        end)
        OrionLib:MakeNotification({
            Name = CurrentVolume == 0 and "✅已静音" or "✅音量恢复",
            Content = "当前音量："..CurrentVolume,
            Time = 2
        })
    end
})

--跳转播放位置（秒）
Tab:AddTextbox({
    Name = "⏱跳转播放位置(秒)",
    Default = "0",
    TextDisappear = true,
    Callback = function(Val)
        local JumpSec = tonumber(Val)
        if not JumpSec or not MusicSound then return end
        pcall(function()
            MusicSound.TimePosition = JumpSec
        end)
        OrionLib:MakeNotification({
            Name = "跳转完成",
            Content = "跳至 "..JumpSec.." 秒",
            Time = 2
        })
    end
})

--彻底销毁音频实例
Tab:AddButton({
    Name = "🗑彻底销毁音频对象",
    Callback = function()
        --关闭自动任务
        if AutoRandomTask then task.cancel(AutoRandomTask) AutoRandomTask = nil end
        AutoRandomEnabled = false
        if MusicSound then
            pcall(function()
                MusicSound:Stop()
                MusicSound:Destroy()
            end)
            MusicSound = nil
            OrionLib:MakeNotification({
                Name = "操作完成",
                Content = "音频对象已完全删除",
                Time = 3
            })
        end
    end
})

--查看当前播放信息
Tab:AddButton({
    Name = "ℹ查看当前播放信息",
    Callback = function()
        if not MusicSound then
            OrionLib:MakeNotification({
                Name = "提示",
                Content = "当前没有播放音频",
                Time = 3
            })
            return
        end
        local PureId = string.gsub(CurrentSoundId,"rbxassetid://","")
        local InfoText = string.format("ID:%s |音量:%d |循环:%s |速度:%.1f",PureId,CurrentVolume,tostring(LoopEnabled),PlaySpeed)
        OrionLib:MakeNotification({
            Name = "播放信息",
            Content = InfoText,
            Time = 4
        })
    end
})

--====================【第二次新增全部功能】====================
--播放速度调节
Tab:AddTextbox({
    Name = "⏩播放速度(0.5‑2)",
    Default = "1",
    TextDisappear = true,
    Callback = function(val)
        local speed = tonumber(val)
        if not speed then speed = 1 end
        if speed <0.5 then speed=0.5 end
        if speed>2 then speed=2 end
        PlaySpeed = speed
        if MusicSound then
            pcall(function() MusicSound.PlaybackSpeed = PlaySpeed end)
        end
        OrionLib:MakeNotification({Name="速度设置",Content="当前倍速: "..PlaySpeed,Time=2})
    end
})

--上一首
Tab:AddButton({
    Name = "⏮上一首",
    Callback = function()
        CurrentPlaylistIndex -=1
        if CurrentPlaylistIndex <1 then CurrentPlaylistIndex = #MusicList end
        local selId = MusicList[CurrentPlaylistIndex]
        CurrentSoundId = "rbxassetid://"..selId
        if MusicSound then
            MusicSound.SoundId = CurrentSoundId
            pcall(function() MusicSound:Play() end)
        end
        OrionLib:MakeNotification({Name="上一首",Content="ID:"..selId,Time=2})
    end
})

--下一首
Tab:AddButton({
    Name = "⏭下一首",
    Callback = function()
        CurrentPlaylistIndex +=1
        if CurrentPlaylistIndex > #MusicList then CurrentPlaylistIndex =1 end
        local selId = MusicList[CurrentPlaylistIndex]
        CurrentSoundId = "rbxassetid://"..selId
        if MusicSound then
            MusicSound.SoundId = CurrentSoundId
            pcall(function() MusicSound:Play() end)
        end
        OrionLib:MakeNotification({Name="下一首",Content="ID:"..selId,Time=2})
    end
})

--添加ID到预置歌单
Tab:AddTextbox({
    Name = "➕添加ID到歌单",
    Default = "输入数字ID",
    TextDisappear = true,
    Callback = function(val)
        local id = string.gsub(val,"%s","")
        if #id <3 then return end
        table.insert(MusicList,id)
        OrionLib:MakeNotification({Name="添加成功",Content="已加入歌单 ID:"..id,Time=2})
    end
})

--清空自定义歌单
Tab:AddButton({
    Name = "🧹清空自定义歌单",
    Callback = function()
        MusicList = {
            "1845918434", 
            "1843463175",
            "1837844742",
            "1843497734",
            "1840172845",
            "1334940365"
        }
        CurrentPlaylistIndex = 1
        OrionLib:MakeNotification({Name="已重置歌单",Content="恢复原始预置列表",Time=3})
    end
})

--设置自动切歌间隔秒数
Tab:AddTextbox({
    Name = "🔁自动切歌间隔(秒)",
    Default = "30",
    TextDisappear = true,
    Callback = function(val)
        local num = tonumber(val)
        if num and num >=5 then AutoRandomDelay = num end
    end
})

--自动随机切歌开关
Tab:AddToggle({
    Name = "🔁开启自动随机切歌",
    Default = false,
    Callback = function(state)
        AutoRandomEnabled = state
        if state then
            AutoRandomTask = task.spawn(function()
                while AutoRandomEnabled do
                    task.wait(AutoRandomDelay)
                    if not AutoRandomEnabled then break end
                    local randI = math.random(1,#MusicList)
                    CurrentPlaylistIndex = randI
                    local sid = MusicList[randI]
                    CurrentSoundId = "rbxassetid://"..sid
                    if MusicSound then
                        pcall(function()
                            MusicSound.SoundId = CurrentSoundId
                            MusicSound:Play()
                        end)
                    end
                end
            end)
        else
            if AutoRandomTask then task.cancel(AutoRandomTask) AutoRandomTask=nil end
        end
    end
})

--获取音频总时长
Tab:AddButton({
    Name = "⏳获取歌曲总时长",
    Callback = function()
        if not MusicSound then
            OrionLib:MakeNotification({Name="错误",Content="没有音频对象",Time=2})
            return
        end
        local dur = MusicSound.TimeLength
        OrionLib:MakeNotification({
            Name = "歌曲总时长",
            Content = string.format("%.1f 秒",dur),
            Time = 3
        })
    end
})

--====================【本次新增功能】====================
--歌曲结束自动下一首开关
Tab:AddToggle({
    Name = "✨歌曲结束自动下一首",
    Default = false,
    Callback = function(state)
        AutoNextOnEnd = state
        if MusicSound and state then
            pcall(function()
                MusicSound.Ended:Connect(function()
                    if AutoNextOnEnd and not LoopEnabled then
                        CurrentPlaylistIndex +=1
                        if CurrentPlaylistIndex>#MusicList then CurrentPlaylistIndex=1 end
                        local selId = MusicList[CurrentPlaylistIndex]
                        CurrentSoundId = "rbxassetid://"..selId
                        MusicSound.SoundId = CurrentSoundId
                        MusicSound:Play()
                    end
                end)
            end)
        end
    end
})

--音量淡入淡出
Tab:AddButton({
    Name = "🌫音量淡入淡出切换",
    Callback = function()
        if not MusicSound then return end
        task.spawn(function()
            local startVol = MusicSound.Volume
            local target = startVol>0 and 0 or LastVolume/100
            local steps = 20
            local delta = (target-startVol)/steps
            for i=1,steps do
                task.wait(FadeTime/steps)
                MusicSound.Volume = startVol + delta*i
            end
            CurrentVolume = math.floor(target*100)
        end)
    end
})

--导出歌单复制到剪贴板
Tab:AddButton({
    Name = "📤导出歌单(复制全部ID)",
    Callback = function()
        local str = table.concat(MusicList,"\n")
        pcall(function() game:GetService("GuiService"):SetClipboard(str) end)
        OrionLib:MakeNotification({Name="导出完成",Content="歌单已复制到剪贴板",Time=3})
    end
})

--导入歌单
Tab:AddTextbox({
    Name = "📥导入歌单(换行分隔ID)",
    Default = "粘贴多行ID",
    TextDisappear = true,
    Callback = function(text)
        for id in string.gmatch(text,"[^\r\n]+") do
            id = string.gsub(id,"%s","")
            if #id>2 then
                table.insert(MusicList,id)
            end
        end
        OrionLib:MakeNotification({Name="导入完成",Content="已批量添加ID进歌单",Time=3})
    end
})

--打印完整歌单
Tab:AddButton({
    Name = "🧾显示全部歌单",
    Callback = function()
        local output = table.concat(MusicList," | ")
        OrionLib:MakeNotification({
            Name="完整歌单",
            Content = #output>180 and output:sub(1,180).."..." or output,
            Time=4
        })
    end
})

--一键全部停止+关闭自动切歌
Tab:AddButton({
    Name = "🛑全部停止&关闭自动切歌",
    Callback = function()
        AutoRandomEnabled = false
        if AutoRandomTask then task.cancel(AutoRandomTask) AutoRandomTask=nil end
        if MusicSound then pcall(function() MusicSound:Stop() end) end
        OrionLib:MakeNotification({Name="总控停止",Content="已停止播放，关闭自动切歌",Time=2})
    end
})

--保存当前ID到Orion配置
Tab:AddButton({
    Name = "📌保存当前ID到配置",
    Callback = function()
        local pure = string.gsub(CurrentSoundId,"rbxassetid://","")
        OrionLib:SetConfig("SavedMusicID",pure)
        OrionLib:SaveConfig()
        OrionLib:MakeNotification({Name="配置已保存",Content="保存ID: "..pure,Time=2})
    end
})
--====================【新增结束】====================

-- 开始播放
Tab:AddButton({
    Name = "开始播放音乐",
    Callback = function()
        if CurrentSoundId == "rbxassetid://0" then
            OrionLib:MakeNotification({
                Name = "错误",
                Content = "请先输入或选择有效的音频ID！",
                Time = 3
            })
            return
        end
        
        if not MusicSound then
            MusicSound = Instance.new("Sound")
            MusicSound.Name = "PlayerMusic"
            MusicSound.Parent = game:GetService("SoundService")
            MusicSound.Looped = LoopEnabled
            MusicSound.Volume = CurrentVolume / 100
            MusicSound.PlaybackSpeed = PlaySpeed
            --绑定结束事件
            pcall(function()
                MusicSound.Ended:Connect(function()
                    if AutoNextOnEnd and not LoopEnabled then
                        CurrentPlaylistIndex +=1
                        if CurrentPlaylistIndex>#MusicList then CurrentPlaylistIndex=1 end
                        local selId = MusicList[CurrentPlaylistIndex]
                        CurrentSoundId = "rbxassetid://"..selId
                        MusicSound.SoundId = CurrentSoundId
                        MusicSound:Play()
                    end
                end)
            end)
        end
        
        MusicSound.SoundId = CurrentSoundId
        pcall(function()
            MusicSound:Play()
        end)
    end
})
-- 重新播放
Tab:AddButton({
    Name = "重新播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Stop()
            MusicSound:Play()
        end
    end
})
-- 停止播放
Tab:AddButton({
    Name = "停止播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Stop()
        end
    end
})
-- 继续播放
Tab:AddButton({
    Name = "继续播放音乐",
    Callback = function()
        if MusicSound then
            MusicSound:Resume()
        end
    end
})
