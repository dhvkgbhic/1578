LyricsLabel.Size = UDim2.new(0.8, 0, 0.2, 0)
LyricsLabel.BackgroundTransparency = 0.8
LyricsLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
LyricsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
