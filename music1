--====================【基础播放控件】====================
Tab:AddButton({
    Name = "开始播放音乐",
    Callback = function()
        if CurrentSoundId == "rbxassetid://0" then
            OrionLib:MakeNotification({Name="错误",Content="请先输入或选择有效的音频ID！",Time=3})
            return
        end
        if not MusicSound then
            MusicSound = Instance.new("Sound")
            MusicSound.Name = "PlayerMusic"
            MusicSound.Parent = game:GetService("SoundService")
            MusicSound.Looped = LoopEnabled
            MusicSound.Volume = CurrentVolume / 100
            MusicSound.PlaybackSpeed = PlaySpeed
            pcall(function()
                MusicSound.Ended:Connect(function()
                    if AutoNextOnEnd and not LoopEnabled then
                        CurrentPlaylistIndex +=1
                        if CurrentPlaylistIndex>#MusicList then CurrentPlaylistIndex=1 end
                        local selId = MusicList[CurrentPlaylistIndex]
                        CurrentSoundId = "rbxassetid://"..selId
                        MusicSound.SoundId = CurrentSoundId
                        MusicSound:Play()
                    end
                end)
            end)
        end
        MusicSound.SoundId = CurrentSoundId
        pcall(function() MusicSound:Play() end)
        
        -- 如果歌词开关是打开的，重新连接歌词同步
        if LyricsEnabled and not LyricsTask then
            LyricsLabel.Visible = true
            -- 触发一次同步
            Tab:AddToggle({ Name = "显示歌词", Default = true, Callback = function() end }) 
            -- 重新运行歌词同步循环
            LyricsTask = task.spawn(function()
                while LyricsEnabled do
                    task.wait(0.1)
                    if not MusicSound then break end
                    local currentTime = MusicSound.TimePosition
                    if LyricsIsTimestamped then
                        for i, line in ipairs(LyricsTable) do
                            local mm, ss, text = string.match(line, "%[(%d+):(%d+)%](.+)")
                            if mm and ss and text then
                                local targetTime = (tonumber(mm) * 60) + tonumber(ss)
                                if currentTime >= targetTime and (i == #LyricsTable or currentTime < (tonumber(string.match(LyricsTable[i+1], "%[(%d+):(%d+)%]")) or 999999) * 1) then
                                    LyricsLabel.Text = text
                                end
                            end
                        end
                    else
                        local currentLine = math.floor(currentTime / LyricsInterval) + 1
                        if currentLine > #LyricsTable then LyricsLabel.Text = "---"
                        elseif currentLine ~= CurrentLyricIndex then
                            CurrentLyricIndex = currentLine
                            LyricsLabel.Text = LyricsTable[currentLine]
                        end
                    end
                end
            end)
        end
    end
})
