-- =============================================
-- WindUI 音乐播放器（含更多标签页）
-- =============================================
local RunService = game:GetService("RunService")
local cloneref = (cloneref or clonereference or function(instance)
    return instance
end)
local ReplicatedStorage = cloneref(game:GetService("ReplicatedStorage"))

local WindUI
do
    local ok, result = pcall(function()
        return require("./src/Init")
    end)
    if ok then
        WindUI = result
    else
        if cloneref(game:GetService("RunService")):IsStudio() then
            WindUI = require(cloneref(ReplicatedStorage:WaitForChild("WindUI"):WaitForChild("Init")))
        else
            WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
        end
    end
end

-- 创建窗口
local Window = WindUI:CreateWindow({
    Title = "音乐播放器",
    Folder = "MusicPlayer",
    Icon = "music",
    Size = UDim2.fromOffset(620, 520),
    Theme = "Dark",
    HideSearchBar = false,
    OpenButton = {
        Title = "音乐播放器",
        CornerRadius = UDim.new(1, 0),
        StrokeThickness = 3,
        Enabled = true,
        Draggable = true,
        OnlyMobile = false,
        Color = ColorSequence.new(
            Color3.fromHex("#30FF6A"),
            Color3.fromHex("#e7ff2f")
        ),
    },
})

-- 核心变量
local MusicSound = nil
local CurrentSoundId = "rbxassetid://0"
local CurrentVolume = 50
local LoopEnabled = true
local LastVolume = CurrentVolume
local PlaySpeed = 1
local AutoRandomEnabled = false
local AutoRandomDelay = 30
local AutoRandomTask = nil
local CurrentPlaylistIndex = 1
local AutoNextOnEnd = false
local FadeTime = 0.5
local SleepTask = nil
local SleepDuration = 60
local LyricsEnabled = false
local LyricsTable = {}
local LyricsIsTimestamped = false
local LyricsInterval = 5
local LyricsTask = nil
local CurrentLyricIndex = 0

-- 歌词界面
local LyricsGui = Instance.new("ScreenGui")
LyricsGui.Name = "LyricsGui"
LyricsGui.ResetOnSpawn = false
