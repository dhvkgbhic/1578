-- ==================== 辅助函数 ====================
local function SetClipboard(text)
    pcall(function()
        game:GetService("GuiService"):SetClipboard(text)
    end)
end

local function GetClipboard()
    local success, result = pcall(function()
        return game:GetService("GuiService"):GetClipboard()
    end)
    return success and result or ""
end

-- 清理旧的Ended连接
local function ClearEndedConnection()
    if EndedConnection then
        pcall(function() EndedConnection:Disconnect() end)
        EndedConnection = nil
    end
end

-- 更新历史记录
local function AddToHistory(id)
    -- 去重并移到最前
    for i, v in ipairs(HistoryList) do
        if v == id then
            table.remove(HistoryList, i)
            break
        end
    end
    table.insert(HistoryList, 1, id)
    if #HistoryList > 10 then
        table.remove(HistoryList, #HistoryList)
    end
end

-- 统一播放函数
local function PlaySoundById(id, loopSingle)
    local soundId = "rbxassetid://" .. id
    if not MusicSound then
        MusicSound = Instance.new("Sound")
        MusicSound.Name = "PlayerMusic"
        MusicSound.Parent = game:GetService("SoundService")
    end
    MusicSound.SoundId = soundId
    MusicSound.Volume = IsMuted and 0 or (CurrentVolume / 100)
    MusicSound.Looped = loopSingle
    MusicSound.PlaybackSpeed = PlaybackSpeed
    pcall(function()
        MusicSound:Play()
    end)
    CurrentSoundId = soundId
    AddToHistory(id)
end

-- 设置播放列表自动切换（用于自定义播放列表）
local function SetupPlaylistAutoNext()
    ClearEndedConnection()
    if LoopMode == "single" or #CustomPlaylist == 0 then
        return
    end
    if #CustomPlaylist == 1 then
        MusicSound.Looped = true
        return
    end
    MusicSound.Looped = false
    EndedConnection = MusicSound.Ended:Connect(function()
        if LoopMode == "list" then
            CurrentPlaylistIndex = (CurrentPlaylistIndex % #CustomPlaylist) + 1
        elseif LoopMode == "random" then
            CurrentPlaylistIndex = math.random(1, #CustomPlaylist)
        elseif LoopMode == "order" then
            if CurrentPlaylistIndex >= #CustomPlaylist then
                MusicSound:Stop()
                ClearEndedConnection()
                return
            else
                CurrentPlaylistIndex = CurrentPlaylistIndex + 1
            end
        end
        MusicSound.SoundId = "rbxassetid://" .. CustomPlaylist[CurrentPlaylistIndex]
        MusicSound.PlaybackSpeed = PlaybackSpeed
        pcall(function() MusicSound:Play() end)
        AddToHistory(CustomPlaylist[CurrentPlaylistIndex])
    end)
end

-- 取消定时停止
local function CancelAutoStop()
    if StopTimerThread then
        StopTimerThread = nil
    end
end

-- 设置定时停止（秒）
local function SetAutoStop(seconds)
    CancelAutoStop()
    if seconds and seconds > 0 then
        StopTimerThread = task.spawn(function()
            task.wait(seconds)
            if MusicSound and MusicSound.IsPlaying then
                MusicSound:Stop()
                ClearEndedConnection()
                OrionLib:MakeNotification({
                    Name = "定时停止",
                    Content = "音乐已自动停止",
                    Time = 3
                })
            end
        end)
    end
end

